{
  "name": "horus-api",
  "version": "1.0.0",
  "description": "API multitenant para conteo de personas (Horus SaaS)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start:debug": "ts-node-dev --respawn --inspect --transpile-only src/main.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "seed": "ts-node-dev --transpile-only src/seed.ts",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs-modules/ioredis": "^2.3.1",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/mongoose": "^12.0.1",
    "@nestjs/passport": "^12.0.2",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@types/nodemailer": "^8.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^17.4.2",
    "ioredis": "^5.3.2",
    "mongoose": "^8.4.0",
    "nodemailer": "^8.0.7",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "~6.0.2"
  }
}
